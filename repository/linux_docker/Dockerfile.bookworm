ARG BASE_PLATFORM=linux/amd64
FROM --platform=${BASE_PLATFORM} debian:bookworm-slim

ARG DOTNET_CHANNEL=10.0
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl wget \
        build-essential pkg-config rsync patchelf file \
        libicu-dev libcurl4-openssl-dev \
        libgtk-3-dev libwebkit2gtk-4.1-dev libayatana-appindicator3-dev \
        libgtk-4-dev libwebkitgtk-6.0-dev \
        sudo lintian rpm gnupg openssh-client \
    && rm -rf /var/lib/apt/lists/*

# appimagetool runs under sudo and self-extracts (no FUSE in containers); sudo
# resets the environment, so APPIMAGE_EXTRACT_AND_RUN must be explicitly kept.
RUN echo 'Defaults env_keep += "APPIMAGE_EXTRACT_AND_RUN"' > /etc/sudoers.d/appimage \
    && chmod 440 /etc/sudoers.d/appimage

RUN set -eu; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) dotnet_arch="x64" ;; \
        arm64) dotnet_arch="arm64" ;; \
        armhf) dotnet_arch="arm" ;; \
        *) echo "Unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh; \
    chmod +x /tmp/dotnet-install.sh; \
    /tmp/dotnet-install.sh --channel "$DOTNET_CHANNEL" --architecture "$dotnet_arch" --install-dir /opt/dotnet; \
    rm /tmp/dotnet-install.sh; \
    ln -s /opt/dotnet/dotnet /usr/local/bin/dotnet

ENV DOTNET_ROOT=/opt/dotnet
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV DOTNET_NOLOGO=1

WORKDIR /work
CMD ["bash"]
